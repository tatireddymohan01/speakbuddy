# ─────────────────────────────────────────────────────────────────────────────
# SpeakBuddy — environment template
# Copy to `.env` and fill in the values for the provider you plan to use.
#   cp .env.example .env
# `.env` is gitignored. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# Which provider handles requests: anthropic | openai | azure
# Only the selected provider's variables need to be filled in.
LLM_PROVIDER=anthropic


# ── Anthropic (Claude) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# claude-sonnet-5 balances quality and latency for speech.
# Also valid: claude-opus-5, claude-haiku-4-5, claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-5


# ── OpenAI (GPT) ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Measured on the Speech Correction task (reply latency, all 5 labels present):
#   gpt-4.1        ~2.6-3.3s  richest grammar explanations   <- recommended
#   gpt-5.4-mini   ~2.2-3.2s  newer generation, cheaper
#   gpt-4o         ~2.4-2.6s  fine, but two generations old
#   gpt-5.5        ~9-11s     too slow for speech, and needs MAX_TOKENS >= 2000
#                             or reasoning eats the whole budget and returns
#                             an empty reply
OPENAI_MODEL=gpt-4.1


# ── Azure OpenAI Service ─────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
# No trailing slash, e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# The deployment name you created in Azure, not the base model name.
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21


# ── Tutor voice (server-side speech) ─────────────────────────────────────────
# Speech is generated on the server so the tutor sounds identical on every
# device. Browser voices vary by operating system and many machines have no
# British or Indian English voice at all.
# Set TTS_ENABLED=false to fall back to whatever voices the browser has.
TTS_ENABLED=true
TTS_PROVIDER=openai
# gpt-4o-mini-tts accepts an accent instruction; the older tts-1 does not.
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Default accent: us | uk | in | au | ca | ie (switchable in the UI).
TTS_ACCENT=us

# Azure only: the deployment serving the speech model.
AZURE_TTS_DEPLOYMENT=
AZURE_TTS_API_VERSION=2025-03-01-preview


# ── Optional tuning ──────────────────────────────────────────────────────────
# Cap on the tutor's reply length. Speech Correction produces the longest
# replies; other modes stay short by themselves. Unused tokens cost nothing.
MAX_TOKENS=700

# Seconds to wait for the provider before giving up.
REQUEST_TIMEOUT_SECONDS=45

# Conversation turns relayed upstream for continuity.
MAX_HISTORY_MESSAGES=20

# Only needed if you serve the frontend from a different origin.
# Comma-separated, e.g. http://localhost:5500,http://127.0.0.1:5500
ALLOWED_ORIGINS=
